{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Handoff State v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1,
      "type": "integer"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ready",
        "running",
        "awaiting_manual",
        "needs_attention",
        "review",
        "completed",
        "paused"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "source": {
      "type": "string"
    },
    "manifest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "mock",
          "codex",
          "antigravity",
          "copilot",
          "claude",
          "cursor"
        ]
      },
      "uniqueItems": true
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "next_agent": {
      "type": "integer",
      "minimum": 0
    },
    "grants": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "mock",
          "codex",
          "antigravity",
          "copilot",
          "claude",
          "cursor"
        ]
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "run": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "agent": {
              "type": "string",
              "enum": [
                "mock",
                "codex",
                "antigravity",
                "copilot",
                "claude",
                "cursor"
              ]
            },
            "base_revision": {
              "type": "integer",
              "minimum": 0
            },
            "started_at": {
              "type": "number"
            },
            "heartbeat_at": {
              "type": "number"
            },
            "pgid": {
              "type": [
                "integer",
                "null"
              ]
            },
            "ended_at": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "agent",
            "base_revision",
            "started_at",
            "heartbeat_at",
            "pgid"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "last_result": {
      "anyOf": [
        {
          "$ref": "result.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "number"
    },
    "updated_at": {
      "type": "number"
    },
    "cooldowns": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "protocol_version",
    "task_id",
    "revision",
    "status",
    "goal",
    "source",
    "manifest",
    "agents",
    "attempts",
    "max_attempts",
    "next_agent",
    "grants",
    "run",
    "last_result",
    "checkpoint",
    "baseline",
    "last_error",
    "created_at",
    "updated_at",
    "cooldowns"
  ]
}
