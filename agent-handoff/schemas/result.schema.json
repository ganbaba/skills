{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Handoff Result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1,
      "type": "integer"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "enum": [
        "continue",
        "done",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "completed": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "next_steps": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    }
  },
  "required": [
    "protocol_version",
    "task_id",
    "run_id",
    "base_revision",
    "outcome",
    "summary",
    "completed",
    "next_steps",
    "decisions",
    "blockers",
    "tests"
  ]
}
